        function evaluateShadowingAttempt(spoken) {
            const target = state.shadowingTarget || '';
            const norm = s => s.toLowerCase().replace(/[^a-z0-9'\s]/g, '').split(/\s+/).filter(Boolean);
            const tWords = norm(target);
            const sWords = norm(spoken);
            let matched = 0;
            const wordChips = tWords.map(w => {
                const ok = sWords.includes(w);
                if (ok) matched++;
                return `<span class="px-1.5 py-0.5 rounded ${ok ? 'bg-emerald-500/20 text-emerald-300' : 'bg-rose-500/20 text-rose-300'}">${escapeHtml(w)}</span>`;
            }).join(' ');

            const score = Math.round((matched / Math.max(1, tWords.length)) * 100);
            const resBox = document.getElementById('shadowing-result-box');
            if (resBox) {
                resBox.classList.remove('hidden');
                resBox.innerHTML = `
                    <div class="flex items-center justify-between font-bold ${score >= 80 ? 'text-emerald-300' : 'text-amber-300'}">
                        <span>Precisión de Shadowing: ${score}%</span>
                        <span>${score >= 80 ? '+25 XP' : 'Inténtalo de nuevo'}</span>
                    </div>
                    <div class="flex flex-wrap gap-1 pt-1">${wordChips}</div>
                `;
            }
            if (score >= 80) {
                addXP(25, 'speaking');
                showToast(`¡Excelente pronunciación (${score}%)! +25 XP`);
            }
        }

        function toggleMicrophone() {
            if (state.isRecording) {
                finishMicrophoneCapture();
                return;
            }

            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                showToast('Tu navegador no soporta micrófono Web Speech; usa el campo de texto.');
                document.getElementById('voice-text-input')?.focus();
                return;
            }

            try {
                const recognition = new SpeechRecognition();
                recognition.lang = 'en-US';
                recognition.continuous = true;
                recognition.interimResults = true;

                state.recognition = recognition;
                state.isRecording = true;
                state.pendingTranscript = '';

                const micBtn = document.getElementById('mic-btn');
                const waveBox = document.getElementById('soundwave-box');
                const liveBox = document.getElementById('live-transcript-box');
                const liveText = document.getElementById('live-transcript-text');
                const statusText = document.getElementById('voice-status-text');

                if (micBtn) micBtn.classList.add('ring-4', 'ring-rose-500/50');
                if (waveBox) waveBox.classList.add('wave-active');
                if (liveBox) liveBox.classList.remove('hidden');
                if (liveText) liveText.textContent = 'Escuchando... (puedes hacer pausas para pensar)';
                if (statusText) statusText.textContent = 'Grabando voz — Pulsa "Enviar ahora" o pausa 2.8s al terminar';

                recognition.onresult = (event) => {
                    let finalChunk = '';
                    let interimChunk = '';
                    let latestConf = null;

                    for (let i = 0; i < event.results.length; i++) {
                        const res = event.results[i];
                        if (res.isFinal) {
                            finalChunk += res[0].transcript + ' ';
                            if (typeof res[0].confidence === 'number' && res[0].confidence > 0) {
                                latestConf = Math.round(res[0].confidence * 100);
                            }
                        } else {
                            interimChunk += res[0].transcript;
                        }
                    }

                    state.pendingTranscript = (finalChunk + interimChunk).trim();
                    state.lastVoiceConfidence = latestConf || 92;

                    if (liveText && state.pendingTranscript) {
                        liveText.textContent = state.pendingTranscript;
                    }

                    clearTimeout(state.silenceTimer);
                    if (state.pendingTranscript) {
                        state.silenceTimer = setTimeout(() => {
                            if (state.isRecording) finishMicrophoneCapture();
                        }, 2800);
                    }
                };

                recognition.onerror = (ev) => {
                    if (ev.error !== 'aborted') {
                        showToast(`Aviso de micrófono: ${ev.error}`);
                    }
                    stopMicrophoneUI();
                };

                recognition.onend = () => {
                    if (state.isRecording) {
                        stopMicrophoneUI();
                        if (state.pendingTranscript) {
                            const textToSend = state.pendingTranscript;
                            state.pendingTranscript = '';
                            processUserUtterance(textToSend, state.lastVoiceConfidence || 90);
                        }
                    }
                };

                recognition.start();
            } catch (e) {
                stopMicrophoneUI();
                showToast('No se pudo iniciar el micrófono.');
            }
        }

        function stopMicrophoneUI() {
            state.isRecording = false;
            clearTimeout(state.silenceTimer);
            const micBtn = document.getElementById('mic-btn');
            const waveBox = document.getElementById('soundwave-box');
            const liveBox = document.getElementById('live-transcript-box');
            const statusText = document.getElementById('voice-status-text');

            if (micBtn) micBtn.classList.remove('ring-4', 'ring-rose-500/50');
            if (waveBox) waveBox.classList.remove('wave-active');
            if (liveBox) liveBox.classList.add('hidden');
            if (statusText) statusText.textContent = 'Listo — Presiona el micrófono o escribe abajo';
        }

        function finishMicrophoneCapture() {
            clearTimeout(state.silenceTimer);
            const captured = (state.pendingTranscript || '').trim();
            const conf = state.lastVoiceConfidence || 91;
            state.pendingTranscript = '';
            state.isRecording = false;
            try {
                state.recognition?.stop();
            } catch (e) {}
            stopMicrophoneUI();

            if (captured) {
                processUserUtterance(captured, conf);
            } else {
                showToast('No se detectó voz. Intenta hablar más cerca del micrófono.');
            }
        }

        function sendTypedVoiceMessage() {
            const input = document.getElementById('voice-text-input');
            const text = (input?.value || '').trim();
            if (!text) return;
            input.value = '';
            processUserUtterance(text, null);
        }

        function analyzeUtteranceLocally(text, level) {
            const rules = [
                {
                    regex: /\bi\s+have\s+(\d+|twenty|thirty|forty|fifty)\s+years\b/i,
                    fix: t => t.replace(/\bi\s+have\s+/i, 'I am '),
                    tip: "En inglés la edad se expresa con el verbo 'to be' ('I am ... years old'), nunca con 'have'."
                },
                {
                    regex: /\bi\s+am\s+agree\b/i,
                    fix: t => t.replace(/\bi\s+am\s+agree\b/i, 'I agree'),
                    tip: "'Agree' es un verbo principal, por lo que se dice directamente 'I agree' (sin 'am')."
                },
                {
                    regex: /\bsince\s+(\d+|two|three|four|five|many)\s+(years|months|days|weeks)\b/i,
                    fix: t => t.replace(/\bsince\s+/i, 'for '),
                    tip: "Para indicar duración ('three years') usa 'for'; reserva 'since' para el punto exacto de inicio."
                },
                {
                    regex: /\bturn\s+(down|on|off|up)\s+(it|them)\b/i,
                    fix: t => t.replace(/\bturn\s+(down|on|off|up)\s+(it|them)\b/i, 'turn $2 $1'),
                    tip: "Con pronombres objeto ('it', 'them'), los phrasal verbs separables llevan el pronombre en medio."
                },
                {
                    regex: /\bpeople\s+is\b/i,
                    fix: t => t.replace(/\bpeople\s+is\b/i, 'people are'),
                    tip: "'People' es un sustantivo plural en inglés, por lo que requiere verbo plural ('people are')."
                }
            ];

            for (const r of rules) {
                if (r.regex.test(text)) {
                    const corrected = r.fix(text);
                    return {
                        hasError: true,
                        original: text,
                        corrected,
                        explanation: r.tip
                    };
                }
            }

            const nativePolishes = {
                A1: "Great clarity! A native speaker might also say: \"" + text.charAt(0).toUpperCase() + text.slice(1) + "\"",
                A2: "Natural phrasing! Keep expanding your ideas with 'because' or 'for example'.",
                B1: "Solid B1 communication! Your sentence structure is clear and grammatically accurate.",
                B2: "Fluent and well-structured! Consider linking your next thought with 'Furthermore' or 'On the other hand'.",
                C1: "Articulate and idiomatic expression calibrated to C1 standards.",
                C2: "Effortless, native-like register and precision."
            };

            return {
                hasError: false,
                original: text,
                corrected: text,
                explanation: nativePolishes[level] || nativePolishes.B1
            };
        }

        function buildTutorReply(userText, level, scenario, analysis) {
            const mode = document.getElementById('voice-mode')?.value || 'natural';
            if (mode === 'strict' && analysis.hasError) {
                return `Good point! Before we continue, let's polish one detail: instead of "${analysis.original}", try saying "${analysis.corrected}". Could you repeat that corrected sentence for me?`;
            }

            const followUps = {
                A1: [
                    "That's very interesting! Tell me more: what do you usually do on weekends?",
                    "Nice! Do you prefer staying at home or going out with friends?",
                    "Great job! What is your favorite food or drink?"
                ],
                A2: [
                    "I see! How long have you been interested in that, and what made you start?",
                    "That sounds great. What are your plans for next month?",
                    "Interesting! Could you describe a memorable experience related to that?"
                ],
                B1: [
                    "That's a thoughtful perspective. What has been the biggest challenge you've faced with that so far?",
                    "Makes complete sense! If you could change one thing about how you approach it, what would it be?",
                    "I like that idea. How do other people around you usually react to it?"
                ],
                B2: [
                    "That's a compelling point. Looking back, do you think things would have turned out differently if you had taken another path?",
                    "Interesting nuance—how do you balance the short-term trade-offs against the long-term benefits?",
                    "I see where you're coming from. What counterarguments do people usually raise against that view?"
                ],
                C1: [
                    "That is a remarkably perceptive observation. To what extent do you think systemic incentives shape individual choices in that domain?",
                    "Well articulated. How would you reconcile that position with competing priorities in a high-stakes environment?",
                    "Fascinating angle—what empirical evidence or real-world precedent best illustrates your thesis?"
                ],
                C2: [
                    "An incisive formulation indeed. Yet one might wonder whether such an approach inadvertently overlooks subtle unintended consequences—how would you address that critique?",
                    "Masterfully put. In light of rapidly shifting paradigms, do you foresee that principle enduring intact or undergoing fundamental revision?",
                    "A nuanced stance. Where precisely would you draw the boundary between pragmatic expediency and foundational principle here?"
                ]
            };

            const pool = followUps[level] || followUps.B1;
            const turnIdx = state.chatHistory.filter(m => m.role === 'tutor').length;
            const prefix = scenario === 'Free Conversation'
                ? ''
                : `[${scenario}] `;
            return `${prefix}${pool[turnIdx % pool.length]}`;
        }

        function processUserUtterance(text, confidence = null) {
            if (state.shadowingTarget) {
                evaluateShadowingAttempt(text);
                return;
            }

            state.chatHistory.push({
                role: 'user',
                text,
                confidence
            });

            const analysis = analyzeUtteranceLocally(text, state.level);
            state.feedbackItems.unshift(analysis);

            if (analysis.hasError) {
                addErrorToNotebook(
                    analysis.original,
                    analysis.corrected,
                    analysis.explanation,
                    `Tutor de Voz · ${state.level}`
                );
            } else {
                addXP(15, 'speaking');
            }

            const scenario = document.getElementById('voice-scenario')?.value || 'Free Conversation';
            const reply = buildTutorReply(text, state.level, scenario, analysis);

            state.chatHistory.push({
                role: 'tutor',
                text: reply,
                showTranslation: false,
                translationData: null
            });

            renderChatMessages();
            renderRealtimeFeedback();
            const rate = parseFloat(document.getElementById('tts-rate')?.value || '1.0');
            speakText(reply, rate);
        }

        function renderRealtimeFeedback() {
            const list = document.getElementById('realtime-feedback-list');
            if (!list) return;

            if (state.feedbackItems.length === 0) {
                list.innerHTML = `
