        // =====================================================================
        // 11. CUADERNO DE ERRORES CON REPASO ACTIVO (ACTIVE RECALL)
        // =====================================================================
        function addErrorToNotebook(original, corrected, explanation, source) {
            const exists = state.notebook.some(n => n.corrected.toLowerCase() === String(corrected).toLowerCase());
            if (!exists) {
                state.notebook.unshift({
                    original,
                    corrected,
                    explanation,
                    source
                });
                updateHeaderMetrics();
                saveProgress();
            }
        }

        function addManualNotebookEntry() {
            const origEl = document.getElementById('manual-note-orig');
            const corrEl = document.getElementById('manual-note-corr');
            const orig = (origEl?.value || '').trim();
            const corr = (corrEl?.value || '').trim();
            if (!orig || !corr) {
                showToast('Completa ambos campos para guardar la nota');
                return;
            }
            addErrorToNotebook(orig, corr, 'Apunte personalizado añadido para repaso activo.', `Manual · ${state.level}`);
            origEl.value = '';
            corrEl.value = '';
            renderNotebook();
            showToast('Nota añadida al cuaderno');
        }

        function verifyNotebookRecall(idx) {
            const entry = state.notebook[idx];
            if (!entry) return;
            const input = document.getElementById(`recall-input-${idx}`);
            const typed = (input?.value || '').trim().toLowerCase().replace(/[.,!?;:]/g, '');
            const target = entry.corrected.toLowerCase().replace(/[.,!?;:]/g, '');

            if (!typed) {
                showToast('Escribe la forma correcta de memoria primero');
                return;
            }

            if (typed === target) {
                masterNotebookEntry(idx);
            } else {
                showToast('Aún no coincide exactamente; escucha el audio e inténtalo de nuevo');
            }
        }

        function masterNotebookEntry(idx) {
            state.notebook.splice(idx, 1);
            addXP(25, 'grammar');
            updateHeaderMetrics();
            saveProgress();
            renderNotebook();
            showToast('¡Estructura dominada y archivada! +25 XP');
        }

        function renderNotebook() {
