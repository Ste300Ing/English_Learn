        // =====================================================================
        // 9. PRÁCTICA INTENSIVA MULTI-PREGUNTA (ABCD / CLOZE / REWRITE / AUDIO)
        // =====================================================================
        function setExerciseFilter(filter) {
            state.exerciseFilter = filter;
            document.querySelectorAll('.filter-btn').forEach(btn => {
                const active = btn.getAttribute('data-filter') === filter;
                btn.className = active
                    ? 'filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-brand-500 text-slate-950'
                    : 'filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-900 text-slate-300 border border-slate-800 hover:text-white';
            });
            applyExerciseFilter();
        }

        function clearTopicFocus() {
            state.topicFocus = null;
            document.getElementById('topic-focus-pill')?.classList.add('hidden');
            state.activeExercises = JSON.parse(JSON.stringify(EXERCISES_BY_LEVEL[state.level] || EXERCISES_BY_LEVEL.B1));
            state.sessionAnswers = {};
            applyExerciseFilter();
        }

        function applyExerciseFilter() {
            const all = state.activeExercises || [];
            state.filteredExercises = state.exerciseFilter === 'ALL'
                ? all
                : all.filter(ex => ex.type === state.exerciseFilter);
            state.currentIndex = 0;

            const allBtn = document.querySelector('.filter-btn[data-filter="ALL"]');
            if (allBtn) allBtn.textContent = `Todos (${all.length})`;

            renderPracticeStage();
        }

        function goToExercise(idx) {
            if (idx < 0 || idx >= state.filteredExercises.length) return;
            state.currentIndex = idx;
            renderPracticeStage();
        }

        function renderPracticeStage() {
            const stage = document.getElementById('exercise-stage');
            const stepLabel = document.getElementById('session-step-label');
            const scoreLabel = document.getElementById('session-score-label');
            const progBar = document.getElementById('session-progress-bar');
            const dotsEl = document.getElementById('session-dots');
            if (!stage) return;

            const list = state.filteredExercises;
            if (!list || list.length === 0) {
                stage.innerHTML = `<p class="text-sm text-slate-400 text-center py-8">No hay ejercicios disponibles en este filtro.</p>`;
                return;
            }

            const total = list.length;
            const idx = Math.min(state.currentIndex, total - 1);
            state.currentIndex = idx;
            const ex = list[idx];
            const ansKey = `${state.exerciseFilter}-${idx}`;
            const savedAns = state.sessionAnswers[ansKey];

            const correctCount = Object.values(state.sessionAnswers).filter(a => a && a.correct).length;
            if (stepLabel) stepLabel.textContent = `Pregunta ${idx + 1} de ${total} · Nivel ${state.level}`;
            if (scoreLabel) scoreLabel.textContent = `${correctCount} aciertos`;
            if (progBar) progBar.style.width = `${Math.round(((idx + 1) / total) * 100)}%`;

            if (dotsEl) {
                dotsEl.innerHTML = list.map((item, i) => {
                    const k = `${state.exerciseFilter}-${i}`;
                    const a = state.sessionAnswers[k];
                    let cls = 'bg-slate-900 text-slate-400 border-slate-800';
                    if (a) {
                        cls = a.correct
                            ? 'bg-emerald-500/20 text-emerald-300 border-emerald-500/50'
                            : 'bg-rose-500/20 text-rose-300 border-rose-500/50';
                    }
                    if (i === idx) cls += ' ring-2 ring-brand-400 font-extrabold text-white';
                    return `
                        <button onclick="goToExercise(${i})" class="w-8 h-8 rounded-lg border text-xs font-mono shrink-0 transition-all ${cls}">
                            ${i + 1}
                        </button>
                    `;
                }).join('');
            }

            const typeBadgeMap = {
                ABCD: 'Lectura & Opción Múltiple',
                CLOZE: 'Rellenar Texto en Contexto',
                REWRITE: 'Reescritura Activa',
                DICTATION: 'Dictado Auditivo'
            };

            let bodyHtml = `
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-1 rounded-lg bg-brand-500/15 border border-brand-500/30 text-xs font-mono font-bold text-brand-300">
                            ${typeBadgeMap[ex.type] || ex.type}
                        </span>
                        <span class="text-xs text-slate-400">${escapeHtml(ex.tag || '')}</span>
                    </div>
                    <span class="text-xs font-mono text-slate-400">CEFR ${state.level}</span>
                </div>
            `;

            if (ex.type === 'ABCD') {
                const letters = ['A', 'B', 'C', 'D'];
                bodyHtml += `
                    ${ex.passage ? `
                        <div class="p-4 rounded-xl bg-slate-950/90 border border-slate-800 text-xs sm:text-sm text-slate-200 leading-relaxed">
                            ${makeWordsInteractive(ex.passage)}
                        </div>
                    ` : ''}
                    <h3 class="text-base sm:text-lg font-bold text-white leading-relaxed">${escapeHtml(ex.question)}</h3>
                    <div class="grid grid-cols-1 gap-2.5">
                        ${(ex.options || []).map((opt, oIdx) => {
                            let optCls = 'bg-slate-900/90 hover:bg-slate-800 border-slate-800 text-slate-200';
                            if (savedAns) {
                                if (oIdx === ex.correctIndex) {
                                    optCls = 'bg-emerald-500/20 border-emerald-500 text-emerald-200 font-semibold';
                                } else if (oIdx === savedAns.chosenIndex) {
                                    optCls = 'bg-rose-500/20 border-rose-500 text-rose-200';
                                }
