        function setLevel(lvl) {
            if (!LEVEL_ORDER.includes(lvl)) return;
            state.level = lvl;
            state.syllabusCategory = 'ALL';
            state.topicFocus = null;
            state.currentIndex = 0;
            state.sessionAnswers = {};
            state.activeExercises = JSON.parse(JSON.stringify(EXERCISES_BY_LEVEL[lvl] || EXERCISES_BY_LEVEL.B1));

            document.querySelectorAll('.level-btn').forEach(btn => {
                const isSelected = btn.getAttribute('data-level') === lvl;
                if (isSelected) {
                    btn.className = 'level-btn px-2.5 py-1 rounded-lg text-xs font-bold transition-all bg-brand-500 text-slate-950 shadow-sm';
                } else {
                    btn.className = 'level-btn px-2.5 py-1 rounded-lg text-xs font-semibold transition-all text-slate-400 hover:text-white';
                }
            });

            const focusPill = document.getElementById('topic-focus-pill');
            if (focusPill) focusPill.classList.add('hidden');

            saveProgress();
            renderSyllabus();
            applyExerciseFilter();
            resetVoiceConversation();
            renderNotebook();
        }

        function switchTab(tab) {
            state.activeTab = tab;
            const views = ['syllabus', 'practice', 'voice', 'notebook'];
            views.forEach(v => {
                const el = document.getElementById(`view-${v}`);
                const btn = document.getElementById(`tab-${v}`);
                if (el) el.classList.toggle('hidden', v !== tab);
                if (btn) {
                    if (v === tab) {
                        btn.className = 'nav-tab flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all bg-slate-800 text-white border border-slate-700 shrink-0';
                    } else {
                        btn.className = 'nav-tab flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all text-slate-400 hover:text-white hover:bg-slate-900 border border-transparent shrink-0';
                    }
                }
            });

            if (tab === 'syllabus') renderSyllabus();
            if (tab === 'practice') renderPracticeStage();
            if (tab === 'voice') {
                renderChatMessages();
                renderScaffoldingPhrases();
            }
            if (tab === 'notebook') renderNotebook();
            if (window.lucide) lucide.createIcons();
        }

