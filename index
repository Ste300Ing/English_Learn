                            <h3 class="text-base sm:text-lg font-extrabold text-white">${escapeHtml(topic.title)}</h3>
                            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">${escapeHtml(topic.explanation)}</p>

                            <!-- Estructura / Fórmula clave (Inglés arriba + Español abajo) -->
                            <div class="p-3 rounded-xl bg-slate-950/90 border border-slate-800 space-y-1">
                                <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400">Estructura / Fórmula clave</span>
                                <p class="font-mono text-xs sm:text-sm font-bold text-brand-300">${escapeHtml(topic.formula)}</p>
                                ${topic.formulaEs ? `<p class="text-xs text-slate-400">${escapeHtml(topic.formulaEs)}</p>` : ''}
                            </div>

                            <!-- Ejemplos bilingües interactivos -->
                            <div class="space-y-2">
                                <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400">Ejemplos (clic en cualquier palabra para inspeccionar)</span>
                                ${(topic.examples || []).map(ex => `
                                    <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800/90 flex items-start justify-between gap-2.5">
                                        <div class="space-y-1">
