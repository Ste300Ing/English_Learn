        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function loadSavedProgress() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (!raw) return;
                const saved = JSON.parse(raw);
                const today = new Date().toISOString().slice(0, 10);

                if (saved.level && LEVEL_ORDER.includes(saved.level)) state.level = saved.level;
                if (typeof saved.xp === 'number') state.xp = saved.xp;
                if (typeof saved.streak === 'number') state.streak = saved.streak;
                if (Array.isArray(saved.studiedTopics)) state.studiedTopics = saved.studiedTopics;
                if (Array.isArray(saved.notebook)) state.notebook = saved.notebook;
                if (saved.skills && typeof saved.skills === 'object') {
                    state.skills = { ...state.skills, ...saved.skills };
                }

                if (saved.savedDate === today) {
                    state.dailyXP = typeof saved.dailyXP === 'number' ? saved.dailyXP : 0;
                    state.dailyBonusClaimed = Boolean(saved.dailyBonusClaimed);
                } else {
                    state.dailyXP = 0;
                    state.dailyBonusClaimed = false;
                }
            } catch (e) {
                console.warn('No se pudo cargar progreso previo:', e);
            }
        }

        function saveProgress() {
            try {
                const today = new Date().toISOString().slice(0, 10);
                localStorage.setItem(STORAGE_KEY, JSON.stringify({
                    savedDate: today,
                    level: state.level,
                    xp: state.xp,
                    dailyXP: state.dailyXP,
                    dailyBonusClaimed: state.dailyBonusClaimed,
                    streak: state.streak,
                    studiedTopics: state.studiedTopics,
                    notebook: state.notebook,
                    skills: state.skills
                }));
            } catch (e) {
                console.warn('No se pudo guardar progreso:', e);
            }
        }

        function updateHeaderMetrics() {
            const xpText = `${state.xp} XP`;
            const xpDesk = document.getElementById('xp-count');
            const xpMob = document.getElementById('xp-count-mobile');
            if (xpDesk) xpDesk.textContent = xpText;
            if (xpMob) xpMob.textContent = xpText;

            const streakDesk = document.getElementById('streak-count');
            const streakMob = document.getElementById('streak-count-mobile');
            if (streakDesk) streakDesk.textContent = `${state.streak} días`;
            if (streakMob) streakMob.textContent = String(state.streak);

            const dailyText = document.getElementById('daily-goal-text');
            const dailyBar = document.getElementById('daily-goal-bar');
            const pct = Math.min(100, Math.round((state.dailyXP / state.dailyGoal) * 100));
            if (dailyText) dailyText.textContent = `${state.dailyXP}/${state.dailyGoal}`;
            if (dailyBar) dailyBar.style.width = `${pct}%`;

            const nbBadge = document.getElementById('notebook-badge');
            if (nbBadge) nbBadge.textContent = String(state.notebook.length);
        }

        function addXP(amount, skillKey = null) {
            state.xp += amount;
            state.dailyXP += amount;

            if (skillKey && typeof state.skills[skillKey] === 'number') {
                state.skills[skillKey] = Math.min(100, state.skills[skillKey] + 3);
            }

            if (state.dailyXP >= state.dailyGoal && !state.dailyBonusClaimed) {
                state.dailyBonusClaimed = true;
                state.xp += 50;
                showToast('🎉 ¡Meta diaria cumplida! +50 XP de bonificación');
            }

            updateHeaderMetrics();
            saveProgress();
        }

        let toastTimeout = null;
        function showToast(msg) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-msg');
            if (!toast || !toastMsg) return;
            toastMsg.textContent = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
                toast.classList.remove('translate-y-0', 'opacity-100');
            }, 3000);
        }

        function speakText(text, rate = 1.0) {
            if (!text || !('speechSynthesis' in window)) return;
            try {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance(text);
                utter.lang = 'en-US';
                utter.rate = rate;
                const voices = window.speechSynthesis.getVoices();
                const preferred = voices.find(v => v.lang.startsWith('en') && (v.name.includes('Google') || v.name.includes('Natural') || v.name.includes('Samantha')))
                    || voices.find(v => v.lang.startsWith('en'));
                if (preferred) utter.voice = preferred;
                window.speechSynthesis.speak(utter);
            } catch (e) {
                console.warn('Error en síntesis de voz:', e);
            }
        }

        function speakFromBtn(btn, rate = 1.0) {
            const text = btn?.getAttribute('data-speak') || '';
            speakText(text, rate);
        }

