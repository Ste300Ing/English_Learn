        function submitABCDAnswer(optionIdx) {
            const idx = state.currentIndex;
            const ex = state.filteredExercises[idx];
            if (!ex) return;
            const ansKey = `${state.exerciseFilter}-${idx}`;
            const alreadyAnswered = Boolean(state.sessionAnswers[ansKey]);
            const isCorrect = optionIdx === ex.correctIndex;

            state.sessionAnswers[ansKey] = {
                correct: isCorrect,
                chosenIndex: optionIdx
            };

            if (!alreadyAnswered) {
                if (isCorrect) {
                    addXP(20, 'grammar');
                    showToast('¡Correcto! +20 XP');
                } else {
                    addErrorToNotebook(
                        ex.options[optionIdx],
                        ex.options[ex.correctIndex],
                        ex.explanation,
                        `Práctica ABCD · ${state.level}`
                    );
                }
            }
            renderPracticeStage();
        }

        function submitClozeAnswer() {
            const idx = state.currentIndex;
            const ex = state.filteredExercises[idx];
            if (!ex) return;
            const inputs = Array.from(document.querySelectorAll('#exercise-stage input[data-blank-idx]'));
            const values = inputs.map(inp => inp.value.trim());
            const blanks = ex.blanks || [];

            const blankResults = blanks.map((b, bIdx) => {
                const userVal = (values[bIdx] || '').toLowerCase();
                const validList = [b.answer, ...(b.accepted || [])].map(v => v.toLowerCase());
                return validList.includes(userVal);
            });

            const allCorrect = blankResults.every(Boolean);
            const ansKey = `${state.exerciseFilter}-${idx}`;
            const alreadyAnswered = Boolean(state.sessionAnswers[ansKey]);

            const detailHtml = blanks.map((b, bIdx) =>
                `<span class="inline-block mr-3 font-mono text-xs">#${bIdx + 1}: <strong>${escapeHtml(b.answer)}</strong></span>`
            ).join('');

            state.sessionAnswers[ansKey] = {
                correct: allCorrect,
                values,
                blankResults,
                detailHtml
            };

            if (!alreadyAnswered) {
                if (allCorrect) {
                    addXP(25, 'grammar');
                    showToast('¡Texto completado con precisión! +25 XP');
                } else {
                    addErrorToNotebook(
                        values.join(' / ') || '(vacío)',
                        blanks.map(b => b.answer).join(' / '),
                        ex.explanation,
                        `Práctica Cloze · ${state.level}`
                    );
                }
            }
            renderPracticeStage();
        }

        function submitRewriteAnswer() {
            const idx = state.currentIndex;
            const ex = state.filteredExercises[idx];
            if (!ex) return;
            const userText = (document.getElementById('rewrite-input')?.value || '').trim();
            if (!userText) {
                showToast('Escribe tu oración en inglés antes de evaluar');
                return;
            }

            const normUser = userText.toLowerCase().replace(/[.,!?;:]/g, '');
            const keyPoints = (ex.keyPoints || []).map(k => k.toLowerCase());
            const isCorrect = keyPoints.length > 0
                ? keyPoints.every(kp => normUser.includes(kp))
                : normUser === ex.targetEnglish.toLowerCase().replace(/[.,!?;:]/g, '');

            const ansKey = `${state.exerciseFilter}-${idx}`;
            const alreadyAnswered = Boolean(state.sessionAnswers[ansKey]);

            state.sessionAnswers[ansKey] = {
                correct: isCorrect,
                userText,
                detailHtml: `<p class="font-mono text-xs">Modelo sugerido: <strong>${escapeHtml(ex.targetEnglish)}</strong></p>`
            };

            if (!alreadyAnswered) {
                if (isCorrect) {
                    addXP(30, 'syntax');
                    showToast('¡Reescritura excelente! +30 XP');
                } else {
                    addErrorToNotebook(
                        userText,
                        ex.targetEnglish,
                        ex.explanation,
                        `Reescritura · ${state.level}`
                    );
                }
            }
            renderPracticeStage();
        }

        function submitDictationAnswer() {
            const idx = state.currentIndex;
            const ex = state.filteredExercises[idx];
            if (!ex) return;
            const userText = (document.getElementById('dictation-input')?.value || '').trim();
            if (!userText) {
                showToast('Escribe lo que escuchaste antes de verificar');
                return;
            }

            const normalize = s => s.toLowerCase().replace(/[^a-z0-9'\s]/g, '').replace(/\s+/g, ' ').trim();
            const targetWords = normalize(ex.audioText).split(' ');
            const userWords = normalize(userText).split(' ');
            let hits = 0;
            targetWords.forEach(w => {
                if (userWords.includes(w)) hits++;
            });
            const accuracy = hits / Math.max(1, targetWords.length);
            const isCorrect = accuracy >= 0.85;

            const ansKey = `${state.exerciseFilter}-${idx}`;
            const alreadyAnswered = Boolean(state.sessionAnswers[ansKey]);

            state.sessionAnswers[ansKey] = {
                correct: isCorrect,
                userText,
                detailHtml: `<p class="font-mono text-xs">Transcripción exacta (${Math.round(accuracy * 100)}%): <strong>${escapeHtml(ex.audioText)}</strong></p>`
            };

            if (!alreadyAnswered) {
                if (isCorrect) {
                    addXP(25, 'listening');
                    showToast('¡Gran oído! Dictado aprobado +25 XP');
                } else {
                    addErrorToNotebook(
                        userText,
                        ex.audioText,
                        ex.explanation,
                        `Dictado · ${state.level}`
                    );
                }
            }
            renderPracticeStage();
        }

