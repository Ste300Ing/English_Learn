                            </button>
                            <button onclick="closePlacementTest()" class="px-4 py-2.5 rounded-xl bg-slate-800 text-slate-300 text-xs font-semibold">
                                Cerrar
                            </button>
                        </div>
                    </div>
                `;
                return;
            }

            const currentLvl = LEVEL_ORDER[state.placement.levelIdx];
            const targetCompetency = PLACEMENT_COMPETENCIES[state.placement.step % PLACEMENT_COMPETENCIES.length];
            const pool = PLACEMENT_POOL[currentLvl];
            const matchingPool = pool.filter(item => item.skill === targetCompetency);
            const activePool = matchingPool.length > 0 ? matchingPool : pool;

            const usageKey = `${currentLvl}-${targetCompetency}`;
            const used = state.placement.usedIndices[usageKey] || 0;
            const qObj = activePool[used % activePool.length];
            state.placement.usedIndices[usageKey] = used + 1;
            state.placement.currentQ = qObj;

            const progressPct = Math.round(((state.placement.step + 1) / totalSteps) * 100);
            const liveHits = state.placement.history.filter(h => h.correct).length;

            let questionContentHtml = '';
            if (qObj.type === 'LISTENING') {
                questionContentHtml = `
                    <div class="p-4 rounded-xl bg-slate-950/90 border border-brand-500/30 flex flex-wrap items-center justify-between gap-3">
