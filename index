        function buildLocalTranslationAndGlossary(englishText) {
            const knownTranslations = {
                "Hi! Welcome to our free conversation session. What is your name, and what do you like doing in your free time?":
                    "¡Hola! Bienvenido a nuestra sesión de conversación libre. ¿Cómo te llamas y qué te gusta hacer en tu tiempo libre?",
                "Hello! Today we can talk about anything you like. Tell me, what have you been doing this week?":
                    "¡Hola! Hoy podemos hablar de lo que quieras. Cuéntame, ¿qué has estado haciendo esta semana?",
                "Hey there! Welcome to Free Talk mode. What topic, hobby, or current project would you like to discuss today?":
                    "¡Hola! Bienvenido al modo de Charla Libre. ¿Qué tema, pasatiempo o proyecto actual te gustaría conversar hoy?",
                "Welcome! Since this is an open conversation, feel free to steer the topic. What's been on your mind lately—work, culture, or technology?":
                    "¡Bienvenido! Como esta es una conversación abierta, siéntete libre de guiar el tema. ¿Qué has tenido en mente últimamente: trabajo, cultura o tecnología?",
                "Good to see you! In this open session, we can explore any nuanced topic you'd like. What issue or idea has captured your curiosity recently?":
                    "¡Qué gusto verte! En esta sesión abierta podemos explorar cualquier tema con matices que desees. ¿Qué asunto o idea ha capturado tu curiosidad recientemente?",
                "Delighted to converse with you. Consider the floor entirely yours—what intellectual, cultural, or professional subject shall we dissect today?":
                    "Encantado de conversar contigo. Considera la palabra enteramente tuya: ¿qué tema intelectual, cultural o profesional analizaremos hoy?"
            };

            const words = englishText.match(/[A-Za-z]{5,}/g) || [];
            const unique = [...new Set(words.map(w => w.toLowerCase()))].slice(0, 4);
            const glossary = unique.map(w => {
                const hit = LEXICON_DICT[w];
                return hit
                    ? `<strong>${escapeHtml(w)}</strong>: ${escapeHtml(hit.es)}`
                    : `<strong>${escapeHtml(w)}</strong>: haz clic sobre la palabra arriba para escuchar su pronunciación`;
            });

            const tr = knownTranslations[englishText]
                || "Traducción contextual: El tutor te invita a desarrollar tu idea en inglés respondiendo a su pregunta sobre el escenario actual. Puedes hacer clic en cualquier palabra desconocida para escucharla.";

            return { translation: tr, glossary };
        }

