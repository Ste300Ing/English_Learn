<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FluentLab — Aprende Inglés de Forma Dinámica (A1–C2)</title>
    <!-- Tipografías Inter y JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        brand: {
                            300: '#67e8f9',
                            400: '#22d3ee',
                            500: '#06b6d4',
                            600: '#0891b2',
                        },
                        accent: {
                            300: '#c4b5fd',
                            400: '#a78bfa',
                            500: '#8b5cf6',
                            600: '#7c3aed',
                        }
                    }
                }
            }
        };
    </script>
    <!-- Iconos Lucide -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body {
            background-color: #020617;
            color: #f8fafc;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }
        .glass-panel {
            background: rgba(15, 23, 42, 0.78);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(51, 65, 85, 0.75);
        }
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        .cloze-input {
            background: rgba(2, 6, 23, 0.9);
            border: 1.5px solid #334155;
            border-radius: 0.5rem;
            padding: 0.25rem 0.65rem;
            color: #38bdf8;
            font-family: 'JetBrains Mono', monospace;
            font-weight: 600;
            font-size: 0.85em;
            min-width: 135px;
            max-width: 100%;
            width: auto;
            text-align: center;
            transition: all 0.2s ease;
        }
        .cloze-input::placeholder {
            color: #94a3b8;
            font-weight: 400;
            opacity: 1;
        }
        .cloze-input:focus {
            outline: none;
            border-color: #22d3ee;
            box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.18);
        }
        .cloze-input.correct {
            border-color: #10b981;
            background: rgba(16, 185, 129, 0.15);
            color: #6ee7b7;
        }
        .cloze-input.incorrect {
            border-color: #f43f5e;
            background: rgba(244, 63, 94, 0.15);
            color: #fda4af;
        }
        .word-token {
            cursor: pointer;
            border-radius: 0.25rem;
            padding: 0 2px;
            transition: background-color 0.15s ease, color 0.15s ease;
        }
        .word-token:hover {
            background-color: rgba(34, 211, 238, 0.2);
            color: #67e8f9;
            text-decoration: underline;
            text-decoration-style: dotted;
        }
        @keyframes pulseWave {
            0%, 100% { transform: scaleY(0.35); }
            50% { transform: scaleY(1); }
        }
        .wave-bar {
            transform-origin: center;
            transition: transform 0.2s ease;
        }
        .wave-active .wave-bar {
            animation: pulseWave 0.75s ease-in-out infinite;
        }
        .wave-active .wave-bar:nth-child(2) { animation-delay: 0.1s; }
        .wave-active .wave-bar:nth-child(3) { animation-delay: 0.2s; }
        .wave-active .wave-bar:nth-child(4) { animation-delay: 0.3s; }
        .wave-active .wave-bar:nth-child(5) { animation-delay: 0.15s; }
        .wave-active .wave-bar:nth-child(6) { animation-delay: 0.25s; }
        .wave-active .wave-bar:nth-child(7) { animation-delay: 0.05s; }
    </style>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 selection:bg-brand-500/30 selection:text-brand-300">

    <!-- Fondo decorativo sutil -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
        <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-brand-500/10 blur-3xl"></div>
        <div class="absolute top-1/3 -right-32 w-96 h-96 rounded-full bg-accent-500/10 blur-3xl"></div>
    </div>

    <!-- BARRA SUPERIOR DE NAVEGACIÓN Y NIVELES CEFR -->
    <header class="sticky top-0 z-40 border-b border-slate-800/90 bg-slate-950/90 backdrop-blur-xl">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
            <!-- Marca + Métricas Móviles -->
            <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-400 to-accent-600 flex items-center justify-center text-slate-950 font-extrabold shadow-lg shadow-brand-500/20">
                        <i data-lucide="sparkles" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="font-extrabold text-base sm:text-lg tracking-tight text-white">FluentLab</span>
                            <span class="text-[10px] font-mono font-bold uppercase px-1.5 py-0.5 rounded bg-brand-500/15 text-brand-300 border border-brand-500/30">CEFR A1–C2</span>
                        </div>
                        <p class="text-[11px] text-slate-400 hidden sm:block">Inglés activo: Temario, Cloze, ABCD, Sintaxis & Tutor de Voz</p>
                    </div>
                </div>

                <!-- Métricas móviles -->
                <div class="flex lg:hidden items-center gap-1.5">
                    <button onclick="openSyntaxTrainer()" class="px-2 py-1 rounded-lg bg-emerald-500/15 border border-emerald-500/30 text-xs font-bold text-emerald-300" title="Constructor Sintáctico">
                        Sintaxis
                    </button>
                    <button onclick="openPlacementTest()" class="px-2 py-1 rounded-lg bg-accent-500/15 border border-accent-500/30 text-xs font-bold text-accent-300">
                        Test
                    </button>
                    <div class="px-2 py-1 rounded-lg bg-amber-500/10 border border-amber-500/25 flex items-center gap-1 text-xs font-bold text-amber-300">
                        <i data-lucide="flame" class="w-3.5 h-3.5"></i>
                        <span id="streak-count-mobile">5</span>
                    </div>
                    <div class="px-2 py-1 rounded-lg bg-brand-500/10 border border-brand-500/25 flex items-center gap-1 text-xs font-bold text-brand-300">
                        <i data-lucide="zap" class="w-3.5 h-3.5"></i>
                        <span id="xp-count-mobile">450 XP</span>
                    </div>
                </div>
            </div>

            <!-- Herramientas + Selector de Niveles A1 a C2 + Métricas Desktop -->
            <div class="flex items-center justify-between lg:justify-end gap-2">
                <button onclick="openSyntaxTrainer()" class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-500/35 text-xs font-bold text-emerald-200 transition-all" title="Entrena el orden exacto de las palabras en inglés (A1–C2)">
                    <i data-lucide="puzzle" class="w-3.5 h-3.5 text-emerald-400"></i>
                    <span>Sintaxis</span>
                </button>

                <button onclick="openPlacementTest()" class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-accent-500/15 hover:bg-accent-500/25 border border-accent-500/35 text-xs font-bold text-accent-200 transition-all" title="Descubre tu nivel CEFR real en 30 preguntas adaptativas">
                    <i data-lucide="compass" class="w-3.5 h-3.5 text-accent-400"></i>
                    <span>Test de Nivel</span>
                </button>

                <button onclick="openSkillsDashboard()" class="hidden md:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-xs font-bold text-slate-200 transition-all" title="Ver tu panel de habilidades y áreas a reforzar">
                    <i data-lucide="bar-chart-3" class="w-3.5 h-3.5 text-brand-400"></i>
                    <span>Habilidades</span>
                </button>

                <!-- Selector A1 a C2 -->
                <div class="flex items-center gap-1 p-1 rounded-xl bg-slate-900 border border-slate-800 overflow-x-auto no-scrollbar" role="group" aria-label="Selector de nivel CEFR">
                    <button onclick="setLevel('A1')" data-level="A1" class="level-btn px-2.5 py-1 rounded-lg text-xs font-semibold transition-all text-slate-400 hover:text-white">A1</button>
                    <button onclick="setLevel('A2')" data-level="A2" class="level-btn px-2.5 py-1 rounded-lg text-xs font-semibold transition-all text-slate-400 hover:text-white">A2</button>
                    <button onclick="setLevel('B1')" data-level="B1" class="level-btn px-2.5 py-1 rounded-lg text-xs font-bold transition-all bg-brand-500 text-slate-950 shadow-sm">B1</button>
                    <button onclick="setLevel('B2')" data-level="B2" class="level-btn px-2.5 py-1 rounded-lg text-xs font-semibold transition-all text-slate-400 hover:text-white">B2</button>
                    <button onclick="setLevel('C1')" data-level="C1" class="level-btn px-2.5 py-1 rounded-lg text-xs font-semibold transition-all text-slate-400 hover:text-white">C1</button>
                    <button onclick="setLevel('C2')" data-level="C2" class="level-btn px-2.5 py-1 rounded-lg text-xs font-semibold transition-all text-slate-400 hover:text-white">C2</button>
                </div>

                <!-- Métricas Desktop -->
                <div class="hidden lg:flex items-center gap-2">
                    <div class="px-3 py-1.5 rounded-xl bg-emerald-500/10 border border-emerald-500/25 flex flex-col gap-1 min-w-[116px]" title="Meta diaria de experiencia (150 XP)">
                        <div class="flex items-center justify-between text-[10px] font-mono font-bold text-emerald-300">
                            <span>META HOY</span>
                            <span id="daily-goal-text">0/150</span>
                        </div>
                        <div class="w-full h-1.5 rounded-full bg-slate-900 overflow-hidden">
                            <div id="daily-goal-bar" class="h-full bg-emerald-400 transition-all duration-300" style="width: 0%;"></div>
                        </div>
                    </div>
                    <div class="px-3 py-1.5 rounded-xl bg-amber-500/10 border border-amber-500/25 flex items-center gap-1.5 text-xs font-bold text-amber-300" title="Racha diaria">
                        <i data-lucide="flame" class="w-4 h-4"></i>
                        <span id="streak-count">5 días</span>
                    </div>
                    <div class="px-3 py-1.5 rounded-xl bg-brand-500/10 border border-brand-500/25 flex items-center gap-1.5 text-xs font-bold text-brand-300" title="Puntos de experiencia">
                        <i data-lucide="zap" class="w-4 h-4"></i>
                        <span id="xp-count">450 XP</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pestañas Principales -->
        <nav class="max-w-7xl mx-auto px-4 pb-2.5 flex items-center gap-2 overflow-x-auto no-scrollbar">
            <button onclick="switchTab('syllabus')" id="tab-syllabus" class="nav-tab flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all bg-slate-800 text-white border border-slate-700 shrink-0">
                <i data-lucide="book-open-check" class="w-4 h-4 text-brand-400"></i>
                <span>1. Temario & Gramática</span>
            </button>
            <button onclick="switchTab('practice')" id="tab-practice" class="nav-tab flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all text-slate-400 hover:text-white hover:bg-slate-900 border border-transparent shrink-0">
                <i data-lucide="layers" class="w-4 h-4 text-emerald-400"></i>
                <span>2. Práctica Intensiva (ABCD / Cloze / Audio)</span>
            </button>
            <button onclick="switchTab('voice')" id="tab-voice" class="nav-tab flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all text-slate-400 hover:text-white hover:bg-slate-900 border border-transparent shrink-0">
                <i data-lucide="mic" class="w-4 h-4 text-accent-400"></i>
                <span>3. Tutor de Voz IA</span>
            </button>
            <button onclick="switchTab('notebook')" id="tab-notebook" class="nav-tab flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all text-slate-400 hover:text-white hover:bg-slate-900 border border-transparent shrink-0">
                <i data-lucide="bookmark-check" class="w-4 h-4 text-amber-400"></i>
                <span>4. Cuaderno de Errores</span>
                <span id="notebook-badge" class="px-1.5 py-0.5 text-[10px] font-mono rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30">2</span>
            </button>
        </nav>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="max-w-7xl mx-auto px-4 py-6">

        <!-- =================================================================
             VISTA 1: TEMARIO Y GRAMÁTICA POR NIVEL (A1–C2)
             ================================================================= -->
        <section id="view-syllabus" class="space-y-6">
            <!-- Cabecera del Nivel -->
            <div class="glass-panel rounded-2xl p-5 sm:p-6 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <div class="space-y-2 max-w-3xl">
                    <div class="flex flex-wrap items-center gap-2">
                        <span id="syllabus-level-badge" class="px-2.5 py-1 rounded-lg bg-brand-500/20 border border-brand-500/40 text-xs font-mono font-bold text-brand-300">NIVEL B1</span>
                        <span id="syllabus-vocab-badge" class="px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-800 text-xs text-slate-300">Meta léxica: ~2,200 palabras</span>
                    </div>
                    <h1 id="syllabus-title" class="text-xl sm:text-2xl font-extrabold text-white">Intermedio Umbral — Autonomía Comunicativa y Matices Temporales</h1>
                    <p id="syllabus-desc" class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                        Domina el contraste entre experiencias pasadas y acciones en curso, phrasal verbs esenciales, modales de deducción y conectores argumentativos. Haz clic sobre cualquier palabra en inglés dentro de los ejemplos para inspeccionar su significado y pronunciación.
                    </p>
                </div>
                <div class="flex flex-col sm:flex-row lg:flex-col gap-2 shrink-0">
                    <button onclick="switchTab('practice')" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-brand-500 to-accent-600 hover:from-brand-400 hover:to-accent-500 text-slate-950 font-bold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-lg">
                        <i data-lucide="play" class="w-4 h-4"></i>
                        <span>Ir a Ejercicios de este Nivel</span>
                    </button>
                    <button onclick="openSyntaxTrainer()" class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-xs font-semibold text-emerald-300 flex items-center justify-center gap-2">
                        <i data-lucide="puzzle" class="w-3.5 h-3.5"></i>
                        <span>Entrenar Orden Sintáctico</span>
                    </button>
                </div>
            </div>

            <!-- Buscador y Filtros por Categoría -->
            <div class="flex flex-col gap-3">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
                    <div id="syllabus-module-progress" class="flex items-center gap-2 text-xs text-slate-300">
                        <!-- Progreso de módulos del nivel activo -->
                    </div>
                    <div class="relative w-full md:w-72">
                        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
                        <input id="syllabus-search" oninput="renderSyllabus()" type="text" placeholder="Buscar tema o regla gramatical..." class="w-full pl-9 pr-3 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-brand-400">
                    </div>
                </div>

                <!-- Barra dinámica con todos los módulos propios del nivel CEFR seleccionado -->
                <div id="syllabus-category-bar" class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-1">
                    <!-- Renderizado dinámicamente según el nivel A1–C2 -->
                </div>
            </div>

            <!-- Rejilla de Fichas Gramaticales -->
            <div id="syllabus-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-5">
                <!-- Renderizado dinámicamente por JS -->
            </div>
        </section>

        <!-- =================================================================
             VISTA 2: PRÁCTICA INTENSIVA MULTI-PREGUNTA
             ================================================================= -->
        <section id="view-practice" class="hidden space-y-5">
            <!-- Barra de Controles de Sesión -->
            <div class="glass-panel rounded-2xl p-4 flex flex-col lg:flex-row lg:items-center justify-between gap-3">
                <div class="flex flex-wrap items-center gap-1.5">
                    <button onclick="setExerciseFilter('ALL')" data-filter="ALL" class="filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-brand-500 text-slate-950">Todos (7)</button>
                    <button onclick="setExerciseFilter('ABCD')" data-filter="ABCD" class="filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-900 text-slate-300 border border-slate-800 hover:text-white">Lectura & ABCD</button>
                    <button onclick="setExerciseFilter('CLOZE')" data-filter="CLOZE" class="filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-900 text-slate-300 border border-slate-800 hover:text-white">Rellenar Texto (Cloze)</button>
                    <button onclick="setExerciseFilter('REWRITE')" data-filter="REWRITE" class="filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-900 text-slate-300 border border-slate-800 hover:text-white">Reescritura Activa</button>
                    <button onclick="setExerciseFilter('DICTATION')" data-filter="DICTATION" class="filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-900 text-slate-300 border border-slate-800 hover:text-white">Dictado Audio</button>
                </div>

                <div class="flex items-center gap-2">
                    <span id="topic-focus-pill" class="hidden px-2.5 py-1 rounded-lg bg-accent-500/20 border border-accent-500/40 text-xs text-accent-200 flex items-center gap-1.5">
                        <span id="topic-focus-label"></span>
                        <button onclick="clearTopicFocus()" class="hover:text-white font-bold">×</button>
                    </span>
                    <button onclick="generateNewPracticeSet()" id="btn-generate-set" class="px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-xs font-bold text-brand-300 flex items-center gap-1.5 transition-all">
                        <i data-lucide="wand-2" class="w-3.5 h-3.5"></i>
                        <span>Nuevo Bloque con IA</span>
                    </button>
                </div>
            </div>

            <!-- Progreso de Sesión -->
            <div class="glass-panel rounded-2xl p-4 space-y-3">
                <div class="flex items-center justify-between text-xs">
                    <span id="session-step-label" class="font-bold text-slate-200">Pregunta 1 de 7</span>
                    <span class="text-slate-400 hidden sm:inline">Atajos: teclas <kbd class="px-1.5 py-0.5 rounded bg-slate-900 border border-slate-700 font-mono">A–D</kbd> y <kbd class="px-1.5 py-0.5 rounded bg-slate-900 border border-slate-700 font-mono">Enter</kbd></span>
                    <span id="session-score-label" class="font-mono font-bold text-emerald-400">0 aciertos</span>
                </div>
                <div class="w-full h-2 rounded-full bg-slate-900 overflow-hidden">
                    <div id="session-progress-bar" class="h-full bg-gradient-to-r from-brand-400 to-accent-500 transition-all duration-300" style="width: 14%;"></div>
                </div>
                <div id="session-dots" class="flex items-center gap-2 overflow-x-auto no-scrollbar pt-1">
                    <!-- Puntos de navegación -->
                </div>
            </div>

            <!-- Tarjeta del Ejercicio Actual -->
            <div id="exercise-stage" class="glass-panel rounded-2xl p-5 sm:p-7 space-y-5">
                <!-- Inyectado dinámicamente -->
            </div>
        </section>

        <!-- =================================================================
             VISTA 3: TUTOR CONVERSACIONAL POR VOZ EN TIEMPO REAL
             ================================================================= -->
        <section id="view-voice" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-5">
            <!-- Panel Izquierdo: Escenario y Configuración -->
            <div class="lg:col-span-3 space-y-4">
                <div class="glass-panel rounded-2xl p-4 space-y-4">
                    <div class="flex items-center gap-2 text-sm font-bold text-white">
                        <i data-lucide="sliders" class="w-4 h-4 text-accent-400"></i>
                        <span>Configuración de Sesión</span>
                    </div>

                    <div class="space-y-1.5">
                        <label class="text-[11px] font-mono uppercase tracking-wider text-slate-400">Escenario Inmersivo</label>
                        <select id="voice-scenario" onchange="resetVoiceConversation()" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-white focus:outline-none focus:border-brand-400">
                            <option value="Free Conversation">🎙️ Conversación Libre (Tema Abierto)</option>
                            <option value="Tech Startup Job Interview">Entrevista en Startup Tecnológica</option>
                            <option value="International Airport & Customs">Aeropuerto Internacional y Aduanas</option>
                            <option value="Cozy Coffee Shop Debate">Charla Casual en Cafetería</option>
                            <option value="Negotiating a Creative Project">Negociando un Proyecto Creativo</option>
                            <option value="Ethical AI & Philosophy Panel">Debate Filosófico sobre IA</option>
                        </select>
                    </div>

                    <div class="space-y-1.5">
                        <label class="text-[11px] font-mono uppercase tracking-wider text-slate-400">Modo de Corrección</label>
                        <select id="voice-mode" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-white focus:outline-none focus:border-brand-400">
                            <option value="natural">Flujo Natural (Corrige en panel lateral)</option>
                            <option value="strict">Entrenador Estricto (Pausa y pide repetir)</option>
                        </select>
                    </div>

                    <div class="space-y-1.5">
                        <div class="flex justify-between text-[11px] text-slate-400">
                            <span>Velocidad de voz del tutor</span>
                            <span id="tts-rate-label" class="font-mono text-brand-300">1.0x</span>
                        </div>
                        <input id="tts-rate" oninput="document.getElementById('tts-rate-label').textContent = this.value + 'x'" type="range" min="0.7" max="1.25" step="0.05" value="1.0" class="w-full accent-brand-400">
                    </div>

                    <button onclick="toggleScaffoldingDrawer()" class="w-full py-2 px-3 rounded-xl bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/35 text-xs font-bold text-amber-200 flex items-center justify-center gap-2 transition-all">
