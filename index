            body.innerHTML = `
                <div class="space-y-2">
                    <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
                        <span class="font-bold text-slate-300">Pregunta ${state.placement.step + 1} de ${totalSteps} <span class="text-slate-500 font-mono">(${liveHits} aciertos)</span></span>
                        <span class="px-2.5 py-0.5 rounded-lg bg-accent-500/15 border border-accent-500/30 text-accent-200 font-semibold">
                            ${escapeHtml(qObj.skill)}
                        </span>
                        <span class="px-2 py-0.5 rounded bg-brand-500/15 text-brand-300 font-mono font-bold">Calibrando: ${currentLvl}</span>
                    </div>
