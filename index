                `;
                return;
            }

            list.innerHTML = state.feedbackItems.map(item => `
                <div class="p-3.5 rounded-xl border text-xs space-y-1.5 ${item.hasError ? 'bg-rose-500/10 border-rose-500/35' : 'bg-emerald-500/10 border-emerald-500/35'}">
