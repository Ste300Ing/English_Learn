                        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
                            <button onclick="setLevel('${recommended}'); closePlacementTest();" class="px-5 py-2.5 rounded-xl bg-brand-500 hover:bg-brand-400 text-slate-950 font-bold text-xs sm:text-sm">
