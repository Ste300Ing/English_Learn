        function toggleStudiedTopic(topicKey) {
            const idx = state.studiedTopics.indexOf(topicKey);
            if (idx === -1) {
                state.studiedTopics.push(topicKey);
                addXP(15, 'grammar');
                showToast('Tema marcado como estudiado (+15 XP)');
            } else {
                state.studiedTopics.splice(idx, 1);
                saveProgress();
            }
            renderSyllabus();
        }

        function practiceSyllabusTopic(topicTitle) {
            state.topicFocus = topicTitle;
            const pill = document.getElementById('topic-focus-pill');
            const label = document.getElementById('topic-focus-label');
            if (pill && label) {
                label.textContent = `Enfoque: ${topicTitle}`;
                pill.classList.remove('hidden');
            }
            switchTab('practice');
            generateNewPracticeSet();
        }

        function makeWordsInteractive(sentence) {
            return String(sentence).split(/(\s+)/).map(part => {
                if (/^\s+$/.test(part)) return part;
                const clean = part.replace(/^[^a-zA-Z'-]+|[^a-zA-Z'-]+$/g, '');
                if (!clean) return escapeHtml(part);
                return `<span class="word-token" onclick="event.stopPropagation(); inspectWord('${clean.replace(/'/g, "\\'")}')">${escapeHtml(part)}</span>`;
            }).join('');
        }

        function inspectWord(word) {
            const clean = String(word || '').trim();
            if (!clean) return;
            const lower = clean.toLowerCase();
            const entry = LEXICON_DICT[lower];
            const meaning = entry
                ? entry.es
                : `Término en contexto (${state.level}). Escucha su pronunciación o guárdalo en tu cuaderno para repasarlo.`;
            const pos = entry ? entry.pos : `CEFR ${state.level}`;

            state.inspectedWordData = { word: clean, pos, meaning };
            const box = document.getElementById('word-inspector');
            const wEl = document.getElementById('wi-word');
            const pEl = document.getElementById('wi-pos');
            const mEl = document.getElementById('wi-meaning');

            if (wEl) wEl.textContent = clean;
            if (pEl) pEl.textContent = pos;
            if (mEl) mEl.textContent = meaning;
            if (box) box.classList.remove('hidden');

            speakText(clean, 0.9);
            if (window.lucide) lucide.createIcons();
        }

        function closeWordInspector() {
            document.getElementById('word-inspector')?.classList.add('hidden');
        }

        function saveInspectedWordToNotebook() {
            if (!state.inspectedWordData) return;
            const { word, meaning } = state.inspectedWordData;
            addErrorToNotebook(
                `Vocabulario: ${word}`,
                word,
                meaning,
                `Inspector Léxico · ${state.level}`
            );
            showToast(`"${word}" guardado en tu cuaderno`);
            closeWordInspector();
        }

