        async function generateNewPracticeSet() {
            const btn = document.getElementById('btn-generate-set');
            const originalHtml = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = `<i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i><span>Generando retos...</span>`;
                if (window.lucide) lucide.createIcons();
            }

            try {
                const apiKey = "";
                if (!apiKey) throw new Error('Sin API key externa, activando generador dinámico local');

                const previousPrompts = (state.activeExercises || [])
                    .map(e => e.question || e.template || e.promptEs || e.audioText)
                    .slice(0, 5)
                    .join(' | ');

                const focusInstruction = state.topicFocus
                    ? `Enfoca todos los ejercicios específicamente en la estructura gramatical: "${state.topicFocus}".`
                    : `Cubre estructuras variadas y exigentes del nivel CEFR ${state.level}.`;

                const prompt = `Genera un bloque nuevo de 7 ejercicios exigentes de inglés para nivel CEFR ${state.level} (para hispanohablantes). ${focusInstruction}
Evita repetir estos enunciados previos: ${previousPrompts}.
Devuelve EXCLUSIVAMENTE un JSON válido con un array "exercises" de 7 objetos:
- 3 objetos con type="ABCD" (al menos 1 con "passage" de lectura densa, "question", "options" de 4 strings, "correctIndex" 0-3, "tag", "explanation" en español).
- 2 objetos con type="CLOZE" ("tag", "instruction" en español, "template" usando ___ para cada hueco, "blanks" array de { "answer": "...", "hint": "..." }, "explanation" en español).
- 1 objeto con type="REWRITE" ("tag", "promptEs", "targetEnglish", "keyPoints" array de frases clave en minúscula, "explanation" en español).
- 1 objeto con type="DICTATION" ("tag", "audioText" en inglés natural de nivel ${state.level}, "hintEs", "explanation" en español).`;

                const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: prompt }] }],
                        generationConfig: { responseMimeType: "application/json" }
                    })
                });

                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                const rawText = data?.candidates?.[0]?.content?.parts?.[0]?.text || '';
                const parsed = JSON.parse(rawText);

                if (!Array.isArray(parsed.exercises) || parsed.exercises.length === 0) {
                    throw new Error('Formato de ejercicios inválido');
                }

                state.activeExercises = parsed.exercises;
                state.sessionAnswers = {};
                applyExerciseFilter();
                showToast(`✨ Nuevo bloque IA (${state.level}) generado`);
            } catch (err) {
                state.activeExercises = buildDynamicFallbackSet(state.level, state.topicFocus);
                state.sessionAnswers = {};
                applyExerciseFilter();
                showToast(`✨ Nuevo bloque de ejercicios (${state.level}) listo`);
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                    if (window.lucide) lucide.createIcons();
                }
            }
        }

