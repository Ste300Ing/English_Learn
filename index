        // =====================================================================
        // 13. TEST DE NIVEL ADAPTATIVO INTEGRAL (12 PASOS · 4 COMPETENCIAS)
        // =====================================================================
        const PLACEMENT_COMPETENCIES = [
            'Gramática & Estructura',
            'Comprensión Lectora',
            'Comprensión Auditiva',
            'Producción Activa (Cloze)'
        ];

        function openPlacementTest() {
            state.placement = {
                active: true,
                step: 0,
                totalSteps: 30,
                levelIdx: 2, // Empieza en B1
                levelScore: 2.0,
                history: [],
                usedIndices: {},
                skillStats: {
                    'Gramática & Estructura': { hits: 0, total: 0 },
                    'Comprensión Lectora': { hits: 0, total: 0 },
                    'Comprensión Auditiva': { hits: 0, total: 0 },
                    'Producción Activa (Cloze)': { hits: 0, total: 0 }
                }
            };
            document.getElementById('placement-modal')?.classList.remove('hidden');
            renderPlacementStep();
        }

        function closePlacementTest() {
            if ('speechSynthesis' in window) window.speechSynthesis.cancel();
            document.getElementById('placement-modal')?.classList.add('hidden');
        }

        function finishPlacementEarly() {
            if ('speechSynthesis' in window) window.speechSynthesis.cancel();
            state.placement.step = state.placement.totalSteps;
            renderPlacementStep();
        }

        function renderPlacementStep() {
            const body = document.getElementById('placement-modal-body');
            if (!body) return;

            const totalSteps = state.placement.totalSteps || 30;

            if (state.placement.step >= totalSteps) {
                const recommended = LEVEL_ORDER[state.placement.levelIdx] || 'B1';
                const answeredCount = state.placement.history.length;
                const totalHits = state.placement.history.filter(h => h.correct).length;
                const overallPct = Math.round((totalHits / Math.max(1, answeredCount)) * 100);

                if (!state.placement.xpAwarded && answeredCount >= 12) {
                    state.placement.xpAwarded = true;
                    addXP(answeredCount >= 30 ? 100 : 40, 'grammar');
                }

                const skillRows = PLACEMENT_COMPETENCIES.map(comp => {
                    const st = state.placement.skillStats[comp] || { hits: 0, total: 1 };
                    const pct = Math.round((st.hits / Math.max(1, st.total)) * 100);
                    return `
                        <div class="p-3 rounded-xl bg-slate-900/90 border border-slate-800 space-y-1.5 text-left">
                            <div class="flex items-center justify-between text-xs font-bold">
