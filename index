            if (qObj.type === 'CLOZE') {
                setTimeout(() => document.getElementById('placement-cloze-input')?.focus(), 100);
            }
        }

        function finalizePlacementTurn(isCorrect) {
            const qObj = state.placement.currentQ;
            if ('speechSynthesis' in window) window.speechSynthesis.cancel();

            if (qObj && state.placement.skillStats[qObj.skill]) {
                state.placement.skillStats[qObj.skill].total += 1;
                if (isCorrect) state.placement.skillStats[qObj.skill].hits += 1;
            }

            state.placement.history.push({
                level: qObj?.level,
                skill: qObj?.skill,
                correct: isCorrect
            });

            // Calibración progresiva en 2 fases: pasos iniciales ajustan más rápido, pasos 11-30 afinan con precisión
            const stepWeight = state.placement.step < 10 ? 0.38 : 0.24;
            const delta = isCorrect ? stepWeight : -stepWeight;
            state.placement.levelScore = Math.max(
                0,
                Math.min(LEVEL_ORDER.length - 1, (state.placement.levelScore ?? 2.0) + delta)
            );
            state.placement.levelIdx = Math.round(state.placement.levelScore);

            state.placement.step += 1;
            renderPlacementStep();
        }

        function answerPlacementStep(chosenIdx) {
            const qObj = state.placement.currentQ;
            if (!qObj) return;
            finalizePlacementTurn(chosenIdx === qObj.correctIndex);
        }

        function submitPlacementCloze() {
            const qObj = state.placement.currentQ;
            if (!qObj) return;
            const raw = (document.getElementById('placement-cloze-input')?.value || '').trim().toLowerCase();
            if (!raw) {
                showToast("Escribe la palabra faltante antes de continuar");
                return;
            }
            const isCorrect = (qObj.accepted || []).map(a => a.toLowerCase()).includes(raw);
            finalizePlacementTurn(isCorrect);
        }

        // =====================================================================
        // 14. CONSTRUCTOR SINTÁCTICO (SENTENCE BUILDER A1–C2)
        // =====================================================================
        function openSyntaxTrainer() {
            state.syntaxIndex = 0;
            loadSyntaxChallenge();
            document.getElementById('syntax-modal')?.classList.remove('hidden');
        }

        function closeSyntaxTrainer() {
            document.getElementById('syntax-modal')?.classList.add('hidden');
        }

        function loadSyntaxChallenge() {
            const list = SYNTAX_BUILDER_DATA[state.level] || SYNTAX_BUILDER_DATA.B1;
            const challenge = list[state.syntaxIndex % list.length];
            state.syntaxSelected = [];
            state.syntaxPool = [...challenge.target, ...(challenge.distractors || [])]
                .map((word, idx) => ({ id: `${idx}-${word}`, word }))
                .sort(() => Math.random() - 0.5);
            renderSyntaxModal();
        }

        function toggleSyntaxToken(tokenId, fromSelected) {
            if (fromSelected) {
                const idx = state.syntaxSelected.findIndex(t => t.id === tokenId);
                if (idx !== -1) {
                    const [tok] = state.syntaxSelected.splice(idx, 1);
                    state.syntaxPool.push(tok);
                }
            } else {
                const idx = state.syntaxPool.findIndex(t => t.id === tokenId);
                if (idx !== -1) {
                    const [tok] = state.syntaxPool.splice(idx, 1);
                    state.syntaxSelected.push(tok);
                }
            }
            renderSyntaxModal();
        }

        function renderSyntaxModal() {
            const body = document.getElementById('syntax-modal-body');
            const lvlTag = document.getElementById('syntax-modal-level');
            if (lvlTag) lvlTag.textContent = state.level;
            if (!body) return;

            const list = SYNTAX_BUILDER_DATA[state.level] || SYNTAX_BUILDER_DATA.B1;
            const challenge = list[state.syntaxIndex % list.length];

            body.innerHTML = `
                <div class="p-3.5 rounded-xl bg-slate-950/90 border border-slate-800 space-y-1">
                    <span class="text-[11px] font-mono uppercase text-emerald-300">Desafío ${(state.syntaxIndex % list.length) + 1} de ${list.length}</span>
                    <p class="text-sm font-bold text-white">${escapeHtml(challenge.promptEs)}</p>
                </div>

                <div class="min-h-[72px] p-3.5 rounded-xl bg-slate-900/90 border-2 border-dashed border-slate-700 flex flex-wrap gap-2 items-center">
                    ${state.syntaxSelected.length === 0
                        ? '<span class="text-xs text-slate-500">Haz clic en los bloques de abajo para ensamblar la oración...</span>'
                        : state.syntaxSelected.map(t => `
                            <button onclick="toggleSyntaxToken('${t.id.replace(/'/g, "\\'")}', true)" class="px-3 py-1.5 rounded-lg bg-brand-500 text-slate-950 font-bold text-xs shadow-sm">
                                ${escapeHtml(t.word)}
                            </button>
                        `).join('')}
                </div>

                <div class="flex flex-wrap gap-2">
                    ${state.syntaxPool.map(t => `
                        <button onclick="toggleSyntaxToken('${t.id.replace(/'/g, "\\'")}', false)" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-semibold text-slate-200">
                            ${escapeHtml(t.word)}
                        </button>
                    `).join('')}
                </div>

                <div id="syntax-feedback-box" class="hidden p-3.5 rounded-xl text-xs space-y-1"></div>

                <div class="pt-2 border-t border-slate-800 flex items-center justify-between">
                    <button onclick="loadSyntaxChallenge()" class="px-3.5 py-2 rounded-xl bg-slate-900 text-xs text-slate-300 hover:text-white">
                        Reiniciar bloques
                    </button>
                    <div class="flex items-center gap-2">
                        <button onclick="checkSyntaxBuild()" class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs">
                            Comprobar Orden
                        </button>
                        <button onclick="state.syntaxIndex++; loadSyntaxChallenge();" class="px-3.5 py-2 rounded-xl bg-slate-800 text-xs font-bold text-white">
                            Siguiente →
                        </button>
                    </div>
                </div>
            `;
        }

        function checkSyntaxBuild() {
            const list = SYNTAX_BUILDER_DATA[state.level] || SYNTAX_BUILDER_DATA.B1;
            const challenge = list[state.syntaxIndex % list.length];
            const built = state.syntaxSelected.map(t => t.word).join(' ');
            const expected = challenge.target.join(' ');
            const fb = document.getElementById('syntax-feedback-box');
            if (!fb) return;

            fb.classList.remove('hidden');
            if (built === expected) {
                fb.className = 'p-3.5 rounded-xl text-xs space-y-1 bg-emerald-500/15 border border-emerald-500/40 text-emerald-200';
                fb.innerHTML = `<p class="font-bold">¡Sintaxis impecable! +30 XP</p><p>${escapeHtml(challenge.ruleTip)}</p>`;
                speakText(expected, 0.95);
                addXP(30, 'syntax');
            } else {
                fb.className = 'p-3.5 rounded-xl text-xs space-y-1 bg-rose-500/15 border border-rose-500/40 text-rose-200';
                fb.innerHTML = `<p class="font-bold">Orden incorrecto o sobran distractores</p><p>Pista: ${escapeHtml(challenge.ruleTip)}</p>`;
            }
        }

        // =====================================================================
        // 15. PANEL DE DOMINIO POR HABILIDADES
        // =====================================================================
        function openSkillsDashboard() {
            const body = document.getElementById('skills-modal-body');
            const modal = document.getElementById('skills-modal');
            if (!body || !modal) return;

            const entries = [
                { key: 'grammar', label: 'Gramática & Lectura CEFR', pct: state.skills.grammar, color: 'bg-brand-400' },
                { key: 'syntax', label: 'Construcción Sintáctica', pct: state.skills.syntax, color: 'bg-emerald-400' },
                { key: 'listening', label: 'Comprensión Auditiva & Dictado', pct: state.skills.listening, color: 'bg-amber-400' },
                { key: 'speaking', label: 'Fluidez Oral & Shadowing', pct: state.skills.speaking, color: 'bg-accent-400' }
            ];
            const weakest = [...entries].sort((a, b) => a.pct - b.pct)[0];

            body.innerHTML = `
                <div class="space-y-3.5">
                    ${entries.map(item => `
                        <div class="space-y-1">
                            <div class="flex justify-between text-xs font-semibold">
                                <span class="text-slate-200">${item.label}</span>
                                <span class="font-mono text-brand-300">${item.pct}%</span>
                            </div>
                            <div class="w-full h-2 rounded-full bg-slate-900 overflow-hidden">
                                <div class="h-full ${item.color} transition-all duration-300" style="width: ${item.pct}%"></div>
                            </div>
                        </div>
                    `).join('')}
                </div>
                <div class="p-4 rounded-xl bg-brand-500/10 border border-brand-500/30 text-xs text-slate-200 space-y-1">
                    <div class="font-bold text-brand-300">Recomendación personalizada para nivel ${state.level}:</div>
                    <p>Tu área con mayor margen de crecimiento es <strong>${weakest.label}</strong> (${weakest.pct}%). Dedica 5 minutos hoy a reforzarla para equilibrar tu perfil.</p>
                </div>
            `;
            modal.classList.remove('hidden');
        }

        function closeSkillsDashboard() {
            document.getElementById('skills-modal')?.classList.add('hidden');
        }

        // =====================================================================
        // 16. ATAJOS DE TECLADO SEGUROS E INICIALIZACIÓN
        // =====================================================================
        document.addEventListener('keydown', (e) => {
            const tag = document.activeElement?.tagName;
            if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
            if (state.activeTab !== 'practice') return;

            const current = state.filteredExercises[state.currentIndex];
            if (!current) return;

            if (current.type === 'ABCD') {
                const map = { a: 0, b: 1, c: 2, d: 3, '1': 0, '2': 1, '3': 2, '4': 3 };
                const k = e.key.toLowerCase();
                if (map[k] !== undefined) {
                    submitABCDAnswer(map[k]);
                }
            }
            if (e.key === 'Enter' && state.currentIndex < state.filteredExercises.length - 1) {
                goToExercise(state.currentIndex + 1);
            }
        });

        window.addEventListener('DOMContentLoaded', () => {
            loadSavedProgress();
            updateHeaderMetrics();
            setLevel(state.level);
            switchTab('syllabus');
            if (window.lucide) lucide.createIcons();
        });
    </script>
</body>
