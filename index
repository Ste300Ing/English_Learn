                            </div>
                        </div>
                    `;
                }).join('');

                const weakestSkill = [...PLACEMENT_COMPETENCIES].sort((a, b) => {
                    const sa = state.placement.skillStats[a];
                    const sb = state.placement.skillStats[b];
                    return (sa.hits / Math.max(1, sa.total)) - (sb.hits / Math.max(1, sb.total));
                })[0];

                body.innerHTML = `
                    <div class="space-y-4 py-1">
                        <div class="text-center space-y-2">
                            <span class="px-3 py-1 rounded-full bg-accent-500/20 border border-accent-500/40 text-xs font-mono font-bold text-accent-300">
                                DIAGNÓSTICO INTEGRAL COMPLETADO · ${totalHits}/${answeredCount} ACIERTOS (${overallPct}%)
                            </span>
                            <h4 class="text-2xl font-extrabold text-white">Nivel CEFR Recomendado: <span class="text-brand-400">${recommended}</span></h4>
                            <p class="text-xs sm:text-sm text-slate-300 max-w-lg mx-auto">
                                Evaluamos tu desempeño adaptativo en las 4 competencias clave. Tu principal oportunidad de mejora está en <strong class="text-amber-300">${escapeHtml(weakestSkill)}</strong>.
                            </p>
